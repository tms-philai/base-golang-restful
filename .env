# Application Configuration
APP_NAME=base-golang-restful
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0
ENVIRONMENT=development

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=60
SERVER_SHUTDOWN_TIMEOUT=30
SERVER_ENABLE_CORS=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=base_golang_restful
DB_SSL_MODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300
DB_AUTO_MIGRATE=true
DB_LOG_QUERIES=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-use-random-string
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=base-golang-restful
JWT_REFRESH_ENABLED=true
JWT_REFRESH_EXP_HOURS=168
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=7d

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./uploads
STORAGE_LOCAL_PATH=./uploads
STORAGE_BASE_URL=http://localhost:8080
STORAGE_MAX_FILE_SIZE=10485760

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1

# Google Cloud Storage Configuration (Optional)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_FILE=
STORAGE_GCS_PROJECT=
STORAGE_GCS_BUCKET=

# Logging Configuration
LOG_LEVEL=info
LOG_OUTPUT_PATH=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# Cache Configuration
CACHE_DEFAULT_EXPIRATION=5m
CACHE_CLEANUP_INTERVAL=10m

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,image/jpg,image/webp

# Pagination Configuration
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8080
SWAGGER_BASE_PATH=/api/v1
