# Application
APP_NAME=base-golang-restful
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0

# Database (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=base_golang_restful
DB_SSL_MODE=disable

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=7d
JWT_ISSUER=base-golang-restful

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# Storage
STORAGE_TYPE=local
STORAGE_BASE_PATH=./uploads
STORAGE_BASE_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_OUTPUT_PATH=./logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# Cache
CACHE_DEFAULT_EXPIRATION=5m
CACHE_CLEANUP_INTERVAL=10m

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
